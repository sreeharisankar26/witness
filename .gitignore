# ─────────────────────────────────────────────────────────────── SECRETS
# Read this section before you push anything.

# Expo access token, written by the control panel. A credential.
tools/control/.expo-token

# Contains EXPO_PUBLIC_LLM_KEY when the vision path is enabled, and your
# laptop's LAN address. Everyone's differs — .env.example is the template.
app/.env
.env
.env.local
*.env.local

# Android signing material, if you ever build locally.
*.keystore
*.jks
credentials.json


# ───────────────────────────────────────────────────────────── GENERATED
# Runtime state. Recreated from the seed on first run — committing it would
# ship one machine's demo state to everyone else.
server/store.json
server/store.json.tmp

# Built artifacts.
witness.apk
*.apk
*.aab

# The tag sheet is generated by tools/make_qr_sheet.py. Kept OUT of the repo
# so it can never drift from the seed data it was printed from — regenerate it
# instead. Delete this line if you would rather ship it.
witness_qr_tags.pdf


# ────────────────────────────────────────────────────────────── TOOLING
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo

android/
ios/

npm-debug.log*
yarn-error.log*
.npm/

__pycache__/
*.py[cod]
.venv/
venv/

.DS_Store
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp

# Diagnostic output from tools/Diagnose.bat and tools/Verify.bat
tools/diagnostic.txt
tools/verify.txt
tools/servercheck.txt
tools/bench.txt
tools/backtest.txt
tools/modeltest.txt

# Editor/agent tooling that happens to live in the tree. Not our source, and
# shipping someone else's skill bundle inside a submission is confusing at best.
.agents/
skills-lock.json
