# Copy to `.env` (same folder). Expo picks up EXPO_PUBLIC_* automatically.
# Restart `npm start` after any change here - these are baked in at bundle time.

# Sync server. MUST be your laptop's LAN IP, not localhost -
# "localhost" on the phone means the phone itself.
# Windows: run `ipconfig` and take the IPv4 Address.
EXPO_PUBLIC_SERVER_URL=http://192.168.1.5:8787

# Model connection. Used for TWO separate things:
#
#   1. NAMEPLATE READING (vision)  - reads the plate on untagged equipment.
#      This is the only place a model is load-bearing. Without a key, rung 2 of
#      the fallback ladder is unavailable and the app tells the worker to type
#      the serial instead. QR scanning and every verdict still work.
#
#   2. PHRASING (text)             - cosmetic. Rewords a verdict that has
#      already been decided. Without a key it speaks the on-device template.
#
# No verdict ever depends on either of these.
EXPO_PUBLIC_LLM_URL=
EXPO_PUBLIC_LLM_KEY=
EXPO_PUBLIC_LLM_MODEL=claude-sonnet-5
EXPO_PUBLIC_VLM_MODEL=claude-sonnet-5
